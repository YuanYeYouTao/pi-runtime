# pi-runtime configuration. Every value here maps to an environment variable that
# `loadConfig()` reads first, so no config.json is needed on the server.
# Install with 600 permissions: this file contains secrets.
#
#   sudo install -m 600 deploy/env.example /etc/pi-rt.env

# ---- Feishu app credentials (open.feishu.cn → 开发者后台 → 凭证与基础信息) ----
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=replace-me

# ---- Who the agent belongs to ----
# The owner's name is how the agent refers to them; the ids must include the owner's open_id,
# otherwise the agent treats their messages as coming from a stranger.
PI_RT_OWNER=Rick
PI_RT_OWNER_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Model ----
PI_RT_PROVIDER=deepseek
PI_RT_MODEL=deepseek-flash
# pi reads its own credentials from $PI_RT_DATA_DIR/pi — run `pi auth` once inside the
# container/volume, or copy ~/.pi into the data volume before first start.

# ---- Storage ----
PI_RT_DATA_DIR=/data
PI_RT_WORKSPACE=/workspace

# ---- Safety ----
# readonly | safe | full. `safe` removes the shell tool; `readonly` also removes write/edit.
PI_RT_SANDBOX=safe
# Daily token budget; 0 disables. This is the only thing between the agent and an unbounded bill.
PI_RT_DAILY_TOKENS=2000000
PI_RT_TASK_TOKENS=200000

# ---- Behaviour ----
PI_RT_MAINTENANCE_MINUTES=5
PI_RT_IDLE_MINUTES=15
PI_RT_BATCH_TURNS=10
PI_RT_BACKUP_KEEP=7
PI_RT_ARCHIVE_DAYS=30
PI_RT_MAX_MINUTES=30

# ---- Optional: restrict which chats may talk to the bot ----
# FEISHU_CHAT_ALLOW=oc_xxx,oc_yyy
